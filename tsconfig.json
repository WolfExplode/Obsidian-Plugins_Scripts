{
  "compilerOptions": {
    "baseUrl": ".",
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "ES6",
    "allowJs": true,
    "noImplicitAny": true,
    "moduleResolution": "node",
    // Type-checking only (tsc runs with noEmit; esbuild does the emit and already
    // handles this interop). Lets tests default-import node:assert/strict.
    "allowSyntheticDefaultImports": true,
    "noEmit": true,
    "importHelpers": true,
    "isolatedModules": true,
    "strictNullChecks": true,
    "lib": [
      "DOM",
      "ES5",
      "ES6",
      "ES7"
    ]
  },
  "include": [
    "**/*.ts"
  ],
  "exclude": [
    "reference/**/*",
    "node_modules"
  ]
}
